# Copier ce fichier en .env.local (ignore par git) et renseigner les valeurs.
# Supabase → Project Settings → API

# Lecture (expose au navigateur, protege par les policies RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ecriture (SERVEUR UNIQUEMENT — ne jamais prefixer NEXT_PUBLIC_,
# cette cle contourne RLS et donne un acces total a la base)
SUPABASE_SERVICE_ROLE_KEY=
